# .env.example — copy to .env and fill in real values.
# This file lists every environment variable the settings files may read.
# NEVER commit .env (it's in .gitignore). Commit only this example file.

# -----------------------------------------------------------------------
# Required in ALL environments
# -----------------------------------------------------------------------

# Django secret key — generate a unique value with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# In dev, base.py provides an insecure fallback so this can be omitted.
# In prod, prod.py will RAISE if this is missing.
SECRET_KEY=replace-me-with-a-real-secret-key

# Selects which settings module Django loads.
# Leave as dev for local work; set to config.settings.prod on the server.
DJANGO_SETTINGS_MODULE=config.settings.dev

# -----------------------------------------------------------------------
# Required only in production (config.settings.prod)
# -----------------------------------------------------------------------

# Comma-separated list of allowed hostnames, e.g.:
#   ALLOWED_HOSTS=api.yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=

# PostgreSQL connection details
DB_NAME=pentecost_attendance
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432
